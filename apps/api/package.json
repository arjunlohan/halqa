{
  "name": "@halqa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono server: tRPC procedures, FHIR endpoints, and the in-process case worker.",
  "exports": {
    ".": "./src/router.ts"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env src/server.ts"
  },
  "dependencies": {
    "@halqa/kernel": "workspace:*",
    "@halqa/pathways": "workspace:*",
    "@halqa/catalogue": "workspace:*",
    "@halqa/fhir": "workspace:*",
    "@halqa/contracts": "workspace:*",
    "@halqa/runtime": "workspace:*",
    "@halqa/voice": "workspace:*",
    "@halqa/evals": "workspace:*",
    "hono": "4.13.19",
    "@hono/node-server": "2.1.9",
    "@hono/trpc-server": "0.4.2",
    "@trpc/server": "11.29.5",
    "zod": "4.6.7",
    "@halqa/review": "workspace:*"
  }
}
