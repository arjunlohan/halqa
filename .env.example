# All optional. With none of these set the prototype runs on the rules brain and a local SQLite file.

# Act selection. "rules" (default) is the deterministic policy. "claude" calls claude-fable-5-2.
# HALQA_BRAIN=claude
# Credentials for the Claude brain, resolved by the Anthropic SDK from the environment.
# With this key set, the console can also ask Claude for a live chart review ("Review again" on a
# case's Records tab), whatever HALQA_BRAIN is. Without it, the stored reviews are shown.
# ANTHROPIC_API_KEY=

# Where the event log lives, and the API port.
# HALQA_DB=./data/halqa.db
# PORT=8787

# Voice. With a key, the call is spoken by ElevenLabs (server side, cached on disk in data/tts-cache).
# Without one, the browser's own speech synthesis is used.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v4
# ELEVENLABS_VOICE_AGENT=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_PATIENT=JBFqnCBsd6RMkjVDRZzb
